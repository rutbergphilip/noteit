{
  "name": "@noteit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "typecheck": "nuxt prepare >/dev/null && vue-tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p tsconfig.server-check.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.142",
    "@internationalized/date": "3.12.4",
    "@noble/ciphers": "2.4.0",
    "@node-rs/argon2": "2.2.1",
    "@noteit/core": "workspace:*",
    "@noteit/doc": "workspace:*",
    "@nuxt/ui": "4.11.3",
    "@tiptap/core": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/vue-3": "3.31.0",
    "fflate": "0.8.2",
    "h3": "1.15.11",
    "nuxt": "4.6.0",
    "nuxt-safe-action": "0.7.0",
    "openid-client": "6.8.8",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "oauth2-mock-server": "9.3.0",
    "typescript": "~5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.12"
  }
}
