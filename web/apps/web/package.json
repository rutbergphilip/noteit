{
  "name": "@noteit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "typecheck": "nuxt prepare >/dev/null && vue-tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p tsconfig.server-check.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@noteit/core": "workspace:*",
    "@noteit/doc": "workspace:*",
    "@tiptap/core": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/vue-3": "3.31.0",
    "h3": "1.15.11",
    "nuxt": "4.6.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vitest": "3.2.4",
    "vue-tsc": "3.3.12"
  }
}
