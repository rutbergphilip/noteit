{
  "name": "noteit-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.62.3",
      "vitest": "4.1.12",
      "@vitest/expect": "4.1.12",
      "@vitest/mocker": "4.1.12",
      "@vitest/pretty-format": "4.1.12",
      "@vitest/runner": "4.1.12",
      "@vitest/snapshot": "4.1.12",
      "@vitest/spy": "4.1.12",
      "@vitest/utils": "4.1.12",
      "vue": "3.5.43",
      "@tiptap/extension-bubble-menu": "3.31.0",
      "@tiptap/extension-floating-menu": "3.31.0",
      "esbuild": "0.28.2",
      "node-forge": "1.4.2"
    }
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @noteit/web dev",
    "build": "pnpm --filter @noteit/web build",
    "start": "pnpm --filter @noteit/web start",
    "e2e": "pnpm --filter @noteit/web e2e"
  }
}
